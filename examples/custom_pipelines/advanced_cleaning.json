{
  "name": "advanced_cleaning",
  "version": "1.0",
  "variables": {"threshold": 3},
  "steps": [
    {"id": "s1", "name": "remove_duplicates", "type": "cleaning", "parameters": {"keep": "first"}, "enabled": true},
    {"id": "s2", "name": "handle_missing", "type": "cleaning", "parameters": {"strategy": "fill_median"}, "enabled": true},
    {"id": "s3", "name": "standardize_text", "type": "cleaning", "parameters": {"case": "lower", "strip": true}},
    {"id": "s4", "name": "scale_features", "type": "transform", "parameters": {"method": "standard"}}
  ]
}
